<%- include('../header') %>

    <style>
        .edit-blog-wrapper {
            max-width: 820px;
            margin: 30px auto;
            background: #394f8b;
            padding: 22px 26px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            font-family: 'Segoe UI', sans-serif;
        }

        .edit-blog-wrapper h2 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 22px;
            color: #e6e8eb;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #f3f1f1;
        }

        .form-group input,
        .form-group textarea {
            padding: 8px 10px;
            border-radius: 7px;
            border: 1px solid #ccc;
            font-size: 13px;
            outline: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #667eea;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 70px;
            grid-column: span 2;
        }

        .image-preview {
            grid-column: span 2;
            display: flex;
            align-items: center;
            gap: 18px;
            margin-top: 8px;
            padding: 10px;
            border: 1px dashed #ddd;
            border-radius: 10px;
            background: #9591a1;
        }

        .image-preview label {
            font-size: 13px;
            font-weight: 600;
            color: #444;
        }

        .image-preview img {
            width: 110px;
            height: auto;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .btn-row {
            grid-column: span 2;
            display: flex;
            justify-content: center;
            margin-top: 18px;
        }

        .btn-row button {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            color: #fff;
            padding: 10px 26px;
            border-radius: 22px;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s ease;
        }

        .btn-row button:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }

        @media(max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group textarea,
            .image-preview,
            .btn-row {
                grid-column: span 1;
            }
        }
    </style>


    <div class="edit-blog-wrapper">
        <h2>Edit Blog</h2>

        <form action="/blog/update-blog/<%= blog._id %>" method="POST" enctype="multipart/form-data">
            <div class="form-grid">

                <div class="form-group">
                    <label>Title</label>
                    <input type="text" name="title" value="<%= blog.title %>" required>
                </div>

                <div class="form-group">
                    <label>Author</label>
                    <input type="text" name="author" value="<%= blog.author %>" required>
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <input type="text" name="category" value="<%= blog.category %>">
                </div>

                <div class="form-group">
                    <label>Tags</label>
                    <input type="text" name="tags" value="<%= blog.tags %>">
                </div>

                <div class="form-group">
                    <label>Publish Date</label>
                    <input type="date" name="publishDate" value="<%= blog.publishDate %>">
                </div>



                <div class="form-group">
                    <label>Short Description</label>
                    <textarea name="shortDesc"><%= blog.shortDesc %></textarea>
                </div>

                <div class="image-preview">
                    <div>
                        <label>Old Image</label><br>
                        <img src="<%= blog.image %>" alt="Blog Image">
                    </div>
                    <div class="form-group">
                        <label>Change Image</label>
                        <input type="file" name="image">
                    </div>
                </div>

                <div class="btn-row">
                    <button type="submit">Update Blog</button>
                </div>

            </div>
        </form>
    </div>

    <%- include('../footer') %>
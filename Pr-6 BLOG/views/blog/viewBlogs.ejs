<%- include('../header') %>

    <style>
        body {
            background-color: #f4f6f9;
        }

        /* ===== Search Box ===== */
        #blogSearch {
            border-radius: 30px;
            padding: 10px 18px;
            font-size: 14px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
            border: none;
            text-align: center;
        }

        #blogSearch:focus {
            outline: none;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.45);
        }

        /* ===== Professional Blog Card ===== */
        .blog-card {
            background: linear-gradient(160deg, #1f2933, #111827);
            color: #e5e7eb;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
            transition: all 0.3s ease;
            height: 100%;
            max-width: 320px;
            margin: auto;
            display: flex;
            flex-direction: column;
        }

        .blog-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
        }

        .blog-img {
            width: 100%;
            height: 280px;
            object-fit: cover;
        }

        .blog-content {
            padding: 18px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .blog-title {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #ffffff;
        }

        .blog-meta {
            font-size: 12.5px;
            color: #9ca3af;
            margin-bottom: 5px;
        }

        .blog-desc {
            font-size: 13.5px;
            margin: 12px 0;
            color: #d1d5db;
            line-height: 1.5;
            flex-grow: 1;
        }

        .blog-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
        }

        .blog-actions a {
            padding: 6px 16px;
            font-size: 12.5px;
            border-radius: 20px;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(90deg, #3b82f6, #2563eb);
        }

        .blog-actions a.delete {
            background: linear-gradient(90deg, #ef4444, #dc2626);
        }
    </style>

    <div class="page-wrapper">

        <!-- Page Title -->
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 text-center">
                    <h4 class="page-title">View Blog</h4>
                </div>
            </div>

            <!-- Search Box -->
            <div class="row justify-content-center mt-3 mb-4">
                <div class="col-lg-4 col-md-6 col-sm-8">
                    <input type="text" id="blogSearch" class="form-control"
                        placeholder="🔍 Search by title, author, category or tags">
                </div>
            </div>
        </div>

        <!-- Blog Cards -->
        <div class="container-fluid">
            <div class="row">

                <% blogs.forEach((blog)=> { %>
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4 blog-item" data-title="<%= blog.title.toLowerCase() %>"
                        data-author="<%= blog.author.toLowerCase() %>"
                        data-category="<%= blog.category.toLowerCase() %>" data-tags="<%= blog.tags.toLowerCase() %>">

                        <div class="blog-card">

                            <img src="<%= blog.image %>" class="blog-img" alt="Blog Image">

                            <div class="blog-content">
                                <div class="blog-title">
                                    <%= blog.title %>
                                </div>

                                <div class="blog-meta">Author: <%= blog.author %>
                                </div>
                                <div class="blog-meta">Category: <%= blog.category %>
                                </div>
                                <div class="blog-meta">Tags: <%= blog.tags %>
                                </div>
                                <div class="blog-meta">Date: <%= blog.publishDate %>
                                </div>

                                <div class="blog-desc">
                                    <%= blog.shortDesc %>
                                </div>

                                <div class="blog-actions">
                                    <a href="/blog/single-view/<%= blog._id %>">View</a>
                                    <a href="/blog/edit-blog/<%= blog._id %>">Edit</a>
                                    <a href="/blog/delete-blog/<%= blog._id %>" class="delete">Delete</a>
                                </div>

                            </div>

                        </div>
                    </div>
                    <% }) %>

            </div>
        </div>
    </div>



    <%- include('../footer') %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Movie</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        }

        .container {
            width: 50%;
            margin: 60px auto;
            background: linear-gradient(135deg, #234d5f, #203a43, #2c5364);
            padding: 30px;
            border-radius: 12px;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            margin-bottom: 25px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 10px;
            color: #ffffff;
        }

        input,
        select {
            width: 95%;
            padding: 7px;
            border-radius: 5px;
            border: none;
        }

        input[type="file"] {
            background: white;
        }

        input[type="submit"] {
            background: #1b1f5e;
            color: white;
            padding: 10px;
            cursor: pointer;
            font-size: 16px;
        }

        input[type="submit"]:hover {
            background: #4b2b7f;
        }
    </style>
</head>

<body>

    <%- include("Common/Header") %>

    <div class="container">
        <h1>🎬 Add Movie</h1>

        <!-- IMPORTANT: enctype already correct -->
        <form action="/add-Movie" method="post" enctype="multipart/form-data">
            <table>

                <tr>
                    <td>Movie Title</td>
                    <td><input type="text" name="title" required></td>
                </tr>

                <tr>
                    <td>Director</td>
                    <td><input type="text" name="director" required></td>
                </tr>

                <tr>
                    <td>Genre</td>
                    <td>
                        <select name="genre" required>
                            <option value="">Select Genre</option>
                            <option>Action</option>
                            <option>Drama</option>
                            <option>Comedy</option>
                            <option>Romance</option>
                            <option>Thriller</option>
                        </select>
                    </td>
                </tr>

                <tr>
                    <td>Release Year</td>
                    <td><input type="number" name="releaseYear" required></td>
                </tr>

                <tr>
                    <td>Duration (Minutes)</td>
                    <td><input type="number" name="duration"></td>
                </tr>

                <tr>
                    <td>Language</td>
                    <td>
                        <select name="language">
                            <option value="">Select Language</option>
                            <option>Hindi</option>
                            <option>English</option>
                            <option>Gujarati</option>
                        </select>
                    </td>
                </tr>

                <tr>
                    <td>Rating (IMDB)</td>
                    <td><input type="text" name="rating" placeholder="eg. 8.5"></td>
                </tr>

                <tr>
                    <td>Status</td>
                    <td>
                        <select name="status">
                            <option value="Available">Available</option>
                            <option value="Not Available">Not Available</option>
                        </select>
                    </td>
                </tr>

                <!-- ✅ IMAGE / POSTER FIELD ADDED -->
                <tr>
                    <td>Movie Poster</td>
                    <td>
                        <input type="file" name="poster">
                    </td>
                </tr>

                <tr>
                    <td colspan="2" style="text-align:center;">
                        <input type="submit" value="Add Movie">
                    </td>
                </tr>

            </table>
        </form>
    </div>
 <%- include("Common/Footer") %>
</body>

</html>

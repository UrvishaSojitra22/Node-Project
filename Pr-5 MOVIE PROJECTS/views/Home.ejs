<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Movies</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        }

        .page-content {
            padding: 40px;
        }

        .banner {
            height: 300px;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.3)),
                url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba");
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            padding-left: 60px;
            color: white;
        }

        .banner-content h1 {
            font-size: 42px;
        }

        .banner-btn {
            background: #ffcc00;
            padding: 10px 20px;
            color: black;
            font-weight: bold;
            border-radius: 5px;
            text-decoration: none;
        }

        .movie-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
            margin-top: 40px;
        }

        .movie-card {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        }

        .movie-poster {
            height: 160px;
            background: #000;
        }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .movie-info {
            padding: 15px;
        }

        .status {
            display: inline-block;
            margin-top: 8px;
            padding: 5px 10px;
            background: green;
            color: white;
            border-radius: 5px;
            font-size: 12px;
        }

        .movie-actions {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
        }

        .btn {
            padding: 6px 12px;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 13px;
        }

        .btn.edit {
            background: #1b1f5e;
        }

        .btn.delete {
            background: crimson;
        }

        .no-data {
            color: white;
            text-align: center;
            margin-top: 40px;
        }
    </style>
</head>

<body>

    <%- include("Common/Header") %>

        <section class="banner">
            <div class="banner-content">
                <h1>Unlimited Movies & Entertainment</h1>
                <a href="/add-Movie" class="banner-btn">➕ Add New Movie</a>
            </div>
        </section>

        <div class="page-content">

            <% if (Movies.length===0) { %>
                <div class="no-data">No Movies Found</div>
                <% } else { %>

                    <div class="movie-cards">
                        <% Movies.forEach((movie)=> { %>

                            <div class="movie-card">

                                <div class="movie-poster">
                                    <% if (movie.poster) { %>
                                        <img src="<%= movie.poster %>">
                                        <% } else { %>
                                            🎬
                                            <% } %>
                                </div>

                                <div class="movie-info">
                                    <h3>
                                        <%= movie.title %>
                                    </h3>
                                    <p><b>Director:</b>
                                        <%= movie.director %>
                                    </p>
                                    <p><b>Genre:</b>
                                        <%= movie.genre %>
                                    </p>

                                    <% if (movie.releaseYear) { %>
                                        <p><b>Year:</b>
                                            <%= movie.releaseYear %>
                                        </p>
                                        <% } %>

                                            <span class="status">
                                                <%= movie.status %>
                                            </span>

                                            <div class="movie-actions">
                                                <a href="/edit-Movie/<%= movie._id %>" class="btn edit">Edit</a>
                                                <a href="/delete-Movie/<%= movie._id %>" class="btn delete"
                                                    onclick="return confirm('Are you sure?')">Delete</a>
                                            </div>
                                </div>

                            </div>

                            <% }) %>
                    </div>

                    <% } %>

        </div>
        <%- include("Common/Footer") %>
</body>

</html>
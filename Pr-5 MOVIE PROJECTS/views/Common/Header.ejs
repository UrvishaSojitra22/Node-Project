<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    .movie-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 40px;
        background: linear-gradient(90deg, #0f2027, #203a43, #2c5364);
        color: white;
    }

    .logo {
        font-size: 26px;
        font-weight: bold;
    }

    .logo span {
        color: #ffcc00;
    }

    .nav-links a {
        margin: 0 15px;
        text-decoration: none;
        color: white;
        font-weight: 500;
        transition: 0.3s;
    }

    .nav-links a:hover {
        color: #ffcc00;
    }

    .search-box input {
        padding: 6px 10px;
        border-radius: 5px;
        border: none;
        outline: none;
    }

    .search-box button {
        padding: 6px 12px;
        border: none;
        background: #ffcc00;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
    }
</style>

<body><!-- ================= HEADER ================= -->
    
    <header class="movie-header">
        <div class="logo">
            🎬 <span>MovieFlix</span>
        </div>

        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/add-Movie">Add Movie</a>
          
        </nav>

     
    </header>
</body>

</html>
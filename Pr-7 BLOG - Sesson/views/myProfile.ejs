<%- include("header") %>

<style>
    body {
        background-color: #f4f6f9;
    }

    .profile-wrapper {
        max-width: 700px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        text-align: center;
    }

    .profile-img {
        width: 160px;
        height: 160px;
        object-fit: cover;
        border-radius: 50%;
        margin-bottom: 15px;
        border: 4px solid #2563eb;
    }

    .profile-name {
        font-size: 26px;
        font-weight: 700;
        color: #1f2937;
    }

    .profile-meta {
        font-size: 14px;
        color: #6b7280;
        margin: 6px 0;
    }

    .profile-info {
        margin-top: 25px;
        text-align: left;
        font-size: 15px;
        line-height: 2;
        background: #f9fafb;
        padding: 20px;
        border-radius: 12px;
    }

    .profile-info span {
        font-weight: 600;
        color: #111827;
    }

    .profile-actions {
        margin-top: 25px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .profile-actions a {
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        color: #fff;
        font-weight: 600;
        background: #2563eb;
    }

    .profile-actions a.edit {
        background: #16a34a;
    }
</style>

<div class="profile-wrapper">

    <% if(user.adminImage){ %>
        <img src="<%= user.adminImage %>" class="profile-img">
    <% } else { %>
        <img src="/images/default-user.png" class="profile-img">
    <% } %>

    <div class="profile-name"><%= user.name %></div>
    <div class="profile-meta"><%= user.email %></div>
    <div class="profile-meta">Role: <%= user.role %></div>
    <div class="profile-meta">Status: <%= user.status %></div>

    <div class="profile-info">
        <div><span>Mobile:</span> <%= user.mobile || '-' %></div>
        <div><span>Address:</span> <%= user.address || '-' %></div>
        <div><span>Joined:</span>
            <%= new Date(user.createdAt).toDateString() %>
        </div>
    </div>

    <div class="profile-actions">
        <a href="/admin/edit-admin/<%= user._id %>" class="edit">Edit Profile</a>
        <a href="/admin/dashboard">Dashboard</a>
    </div>

</div>

<%- include("footer") %>
